                      "name": "inicio_brasilia",
                      "expression": "`inicio_brasilia`"
                    },
                    {
                      "name": "duracao_min",
                      "expression": "`duracao_min`"
                    },
                    {
                      "name": "camada",
                      "expression": "`camada`"
                    }
                  ],
                  "disaggregated": true
                }
              }
            ],
            "spec": {
              "version": 3,
              "widgetType": "scatter",
              "encodings": {
                "x": {
                  "fieldName": "inicio_brasilia",
                  "scale": {
                    "type": "temporal"
                  },
                  "displayName": "Início"
                },
                "y": {
                  "fieldName": "duracao_min",
                  "scale": {
                    "type": "quantitative"
                  },
                  "displayName": "Minutos"
                },
                "color": {
                  "fieldName": "camada",
                  "scale": {
                    "type": "categorical"
                  },
                  "displayName": "Camada"
                }
              },
              "frame": {
                "showTitle": true,
                "title": "Duração das atualizações da silver e da gold (min)"
              }
            }
          },
          "position": {
            "x": 0,
            "y": 10,
            "width": 6,
            "height": 6
          }
        },
        {
          "widget": {
            "name": "t_execucoes",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "ultimas_execucoes",
                  "fields": [
