                  },
                  {
                    "fieldName": "linhas_gravadas",
                    "displayName": "Linhas"
                  },
                  {
                    "fieldName": "duracao_segundos",
                    "displayName": "Duração (s)"
                  },
                  {
                    "fieldName": "erro",
                    "displayName": "Erro"
                  }
                ]
              },
              "frame": {
                "showTitle": true,
                "title": "Últimas execuções da ingestão"
              }
            }
          },
          "position": {
            "x": 0,
            "y": 16,
            "width": 6,
            "height": 8
          }
        }
      ]
    },
    {
      "name": "qualidade_pagina",
      "displayName": "Qualidade",
      "pageType": "PAGE_TYPE_CANVAS",
      "layout": [
        {
          "widget": {
            "name": "t_qual",
            "multilineTextboxSpec": {
              "lines": [
