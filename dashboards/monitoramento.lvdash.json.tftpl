                      "name": "inicio_brasilia",
                      "expression": "`inicio_brasilia`"
                    },
                    {
                      "name": "notebook",
                      "expression": "`notebook`"
                    },
                    {
                      "name": "status",
                      "expression": "`status`"
                    },
                    {
                      "name": "linhas_gravadas",
                      "expression": "`linhas_gravadas`"
                    },
                    {
                      "name": "duracao_segundos",
                      "expression": "`duracao_segundos`"
                    },
                    {
