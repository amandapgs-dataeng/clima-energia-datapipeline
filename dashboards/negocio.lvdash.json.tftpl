            "y": 8,
            "width": 6,
            "height": 6
          }
        }
      ]
    },
    {
      "name": "precisao",
      "displayName": "4. Precisão das previsões",
      "pageType": "PAGE_TYPE_CANVAS",
      "layout": [
        {
          "widget": {
            "name": "t_prec",
            "multilineTextboxSpec": {
              "lines": [
                "## O planejamento acerta?",
                "Programação do ONS: erro hora a hora, usina a usina, em relação à geração verificada. Previsão do tempo: erro da previsão feita na véspera (D+1) em relação ao observado."
              ]
            }
          },
          "position": {
            "x": 0,
            "y": 0,
            "width": 6,
            "height": 1
          }
        },
        {
          "widget": {
            "name": "g_prec_prog",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "precisao_programacao",
                  "fields": [
                    {
                      "name": "mes",
                      "expression": "`mes`"
                    },
                    {
                      "name": "erro_pct",
                      "expression": "`erro_pct`"
                    },
                    {
                      "name": "tipo_usina",
                      "expression": "`tipo_usina`"
                    }
                  ],
                  "disaggregated": true
                }
              }
            ],
            "spec": {
              "version": 3,
              "widgetType": "line",
              "encodings": {
                "x": {
                  "fieldName": "mes",
                  "scale": {
                    "type": "temporal"
                  },
                  "displayName": "Mês"
                },
                "y": {
                  "fieldName": "erro_pct",
                  "scale": {
                    "type": "quantitative"
                  },
                  "displayName": "Erro (%)"
                },
                "color": {
                  "fieldName": "tipo_usina",
                  "scale": {
                    "type": "categorical"
                  },
                  "displayName": "Fonte"
                }
              },
              "frame": {
                "showTitle": true,
                "title": "Erro da programação do ONS (% da geração verificada)"
              }
            }
          },
          "position": {
            "x": 0,
            "y": 1,
            "width": 6,
            "height": 6
          }
        },
        {
          "widget": {
            "name": "g_prec_tempo",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "precisao_tempo",
                  "fields": [
                    {
                      "name": "ponto_id",
                      "expression": "`ponto_id`"
                    },
                    {
                      "name": "erro_vento_kmh",
                      "expression": "`erro_vento_kmh`"
                    }
                  ],
                  "disaggregated": true
                }
              }
            ],
            "spec": {
              "version": 3,
              "widgetType": "bar",
              "encodings": {
                "x": {
                  "fieldName": "ponto_id",
                  "scale": {
                    "type": "categorical"
                  },
                  "displayName": "Ponto"
                },
                "y": {
                  "fieldName": "erro_vento_kmh",
                  "scale": {
                    "type": "quantitative"
                  },
                  "displayName": "km/h"
                }
              },
              "frame": {
                "showTitle": true,
                "title": "Erro médio da previsão D+1 do vento a 100 m, por ponto (km/h)"
              }
            }
          },
          "position": {
            "x": 0,
            "y": 7,
            "width": 6,
            "height": 6
          }
        }
      ]
    },
    {
      "name": "carga",
      "displayName": "Bônus: carga × temperatura",
      "pageType": "PAGE_TYPE_CANVAS",
      "layout": [
        {
          "widget": {
            "name": "t_carga",
            "multilineTextboxSpec": {
              "lines": [
                "## O consumo do Nordeste sobe nos dias mais quentes?",
                "Temperatura média das capitais (Fortaleza, Recife, Salvador). Associação, não causalidade: estação do ano e calendário também influenciam a carga."
              ]
            }
          },
          "position": {
            "x": 0,
            "y": 0,
            "width": 6,
            "height": 1
          }
        },
        {
          "widget": {
            "name": "g_carga",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "carga_temperatura",
                  "fields": [
                    {
                      "name": "temperatura_media_c",
                      "expression": "`temperatura_media_c`"
                    },
                    {
                      "name": "carga_gwmed",
