            "spec": {
              "version": 3,
              "widgetType": "scatter",
              "encodings": {
                "x": {
                  "fieldName": "temperatura_media_c",
                  "scale": {
                    "type": "quantitative"
                  },
                  "displayName": "Temperatura média (°C)"
                },
                "y": {
                  "fieldName": "carga_gwmed",
                  "scale": {
                    "type": "quantitative"
                  },
                  "displayName": "Carga (GW médios)"
                },
                "color": {
                  "fieldName": "tipo_dia",
                  "scale": {
                    "type": "categorical"
                  },
                  "displayName": "Dia"
                }
              },
              "frame": {
                "showTitle": true,
                "title": "Carga do Nordeste (GW médios) × temperatura média (°C)"
              }
            }
