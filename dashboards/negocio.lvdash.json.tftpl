{
  "datasets": [
    {
      "name": "destaques",
      "displayName": "Destaques",
      "queryLines": [
        "SELECT\n",
        "  (SELECT round(sum(geracao_verificada_mwh) / sum(capacidade_mwh) * 100, 1) FROM ${catalog}.gold.aproveitamento_mensal\n",
        "    WHERE tipo_usina = 'Eólica' AND month(mes) BETWEEN 7 AND 10) AS fator_eolico_safra_pct,\n",
        "  (SELECT round(sum(geracao_verificada_mwh) / sum(capacidade_mwh) * 100, 1) FROM ${catalog}.gold.aproveitamento_mensal\n",
        "    WHERE tipo_usina = 'Eólica' AND month(mes) BETWEEN 1 AND 4) AS fator_eolico_entressafra_pct,\n",
        "  (SELECT round(sum(restricao_mwh) / 1e6, 1) FROM ${catalog}.gold.restricao_geracao_diaria) AS restricao_twh,\n",
        "  (SELECT round(avg(correlacao), 2) FROM ${catalog}.gold.correlacao_clima_geracao WHERE variavel = 'vento_100m_ms') AS correlacao_vento,\n",
        "  (SELECT round(avg(erro_medio_absoluto_vento_100m_kmh), 1) FROM ${catalog}.gold.precisao_previsao_tempo) AS erro_previsao_vento_kmh\n"
      ]
    },
    {
      "name": "aproveitamento_ne",
      "displayName": "Aproveitamento do Nordeste por mês",
      "queryLines": [
        "SELECT mes, tipo_usina, round(sum(geracao_verificada_mwh) / sum(capacidade_mwh) * 100, 1) AS fator_pct\n",
        "FROM ${catalog}.gold.aproveitamento_mensal GROUP BY mes, tipo_usina\n"
      ]
    },
    {
      "name": "aproveitamento_uf",
      "displayName": "Aproveitamento por estado",
      "queryLines": [
        "SELECT uf, tipo_usina, round(sum(geracao_verificada_mwh) / sum(capacidade_mwh) * 100, 1) AS fator_pct\n",
        "FROM ${catalog}.gold.aproveitamento_mensal GROUP BY uf, tipo_usina\n"
      ]
    },
    {
      "name": "curva_eolica",
      "displayName": "Curva de potência eólica",
      "queryLines": [
        "SELECT faixa_inicio AS vento_ms, round(fator_capacidade * 100, 1) AS fator_pct, horas\n",
        "FROM ${catalog}.gold.curva_de_potencia WHERE tipo_usina = 'Eólica' AND horas >= 100\n"
      ]
    },
    {
      "name": "curva_solar",
      "displayName": "Curva de potência solar",
      "queryLines": [
        "SELECT faixa_inicio AS radiacao_wm2, round(fator_capacidade * 100, 1) AS fator_pct, horas\n",
        "FROM ${catalog}.gold.curva_de_potencia WHERE tipo_usina = 'Solar' AND horas >= 100\n"
      ]
    },
    {
      "name": "correlacao",
      "displayName": "Correlação clima x geração",
      "queryLines": [
        "SELECT uf, concat(tipo_usina, ': ', CASE variavel WHEN 'vento_100m_ms' THEN 'vento a 100 m'\n",
        "  WHEN 'radiacao_solar_wm2' THEN 'radiação' WHEN 'cobertura_nuvens_pct' THEN 'nuvens' ELSE 'temperatura' END) AS relacao,\n",
        "  round(correlacao, 2) AS correlacao\n",
        "FROM ${catalog}.gold.correlacao_clima_geracao WHERE variavel IN ('vento_100m_ms', 'radiacao_solar_wm2')\n"
      ]
    },
    {
      "name": "restricao_mensal",
      "displayName": "Restrição por mês",
      "queryLines": [
        "SELECT date_trunc('month', data) AS mes, round(sum(restricao_mwh) / 1000, 0) AS restricao_gwh,\n",
        "  round(sum(restricao_mwh) / sum(previsto_mwh) * 100, 1) AS restricao_pct\n",
        "FROM ${catalog}.gold.restricao_geracao_diaria\n",
        "WHERE data < date_trunc('month', current_date())  -- só meses completos\n",
        "GROUP BY 1\n"
      ]
    },
    {
      "name": "restricao_usinas",
      "displayName": "Usinas mais restringidas",
      "queryLines": [
        "SELECT nome_usina, round(sum(restricao_mwh) / 1000, 1) AS restricao_gwh\n",
        "FROM ${catalog}.gold.restricao_geracao_por_usina GROUP BY nome_usina ORDER BY restricao_gwh DESC LIMIT 10\n"
      ]
    },
    {
      "name": "precisao_programacao",
      "displayName": "Precisão da programação do ONS",
      "queryLines": [
        "SELECT mes, tipo_usina, round(sum(erro_absoluto_mwh) / sum(geracao_verificada_mwh) * 100, 1) AS erro_pct\n",
        "FROM ${catalog}.gold.precisao_programacao_mensal GROUP BY mes, tipo_usina\n"
      ]
    },
    {
      "name": "precisao_tempo",
      "displayName": "Precisão da previsão do tempo",
      "queryLines": [
        "SELECT ponto_id, round(avg(erro_medio_absoluto_vento_100m_kmh), 1) AS erro_vento_kmh,\n",
        "  round(avg(vento_100m_observado_kmh), 1) AS vento_medio_kmh\n",
        "FROM ${catalog}.gold.precisao_previsao_tempo GROUP BY ponto_id\n"
      ]
    },
    {
      "name": "carga_temperatura",
      "displayName": "Carga x temperatura",
      "queryLines": [
        "SELECT temperatura_media_c, round(carga_mwmed / 1000, 2) AS carga_gwmed,\n",
        "  CASE WHEN fim_de_semana THEN 'Fim de semana' ELSE 'Dia útil' END AS tipo_dia\n",
        "FROM ${catalog}.gold.carga_x_temperatura\n"
      ]
    }
  ],
  "pages": [
    {
      "name": "visao_geral",
      "displayName": "Visão geral",
      "pageType": "PAGE_TYPE_CANVAS",
      "layout": [
